{
  "name": "gulp-starter-pack",
  "version": "2.0.0",
  "description": "A modern static-site starter kit built on Gulp 5, Tailwind CSS 4, PostCSS and Browsersync — with HTML partials, live reload and an optimized production build.",
  "type": "module",
  "main": "gulpfile.js",
  "scripts": {
    "dev": "gulp",
    "start": "gulp",
    "build": "gulp build",
    "prod": "gulp build",
    "clean": "gulp clean",
    "zip": "gulp zip",
    "deploy": "gulp surge",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmanow/gulp-starter-pack.git"
  },
  "bugs": {
    "url": "https://github.com/rahmanow/gulp-starter-pack/issues"
  },
  "homepage": "https://github.com/rahmanow/gulp-starter-pack#readme",
  "keywords": [
    "gulp",
    "gulp5",
    "tailwindcss",
    "tailwind",
    "postcss",
    "browsersync",
    "starter-kit",
    "boilerplate",
    "template",
    "static-site",
    "frontend",
    "scaffolding"
  ],
  "author": "Azat Rahmanov",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "browser-sync": "^3.0.4",
    "cssnano": "^9.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-file-include": "^2.3.0",
    "gulp-postcss": "^10.0.0",
    "gulp-terser": "^2.1.0",
    "gulp-zip": "^6.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
