# Normalize line endings on checkin, check out native
* text=auto eol=lf

# Binary assets — never diff or convert
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# Keep generated lockfile diffs collapsed in PR review
package-lock.json linguist-generated=true -diff
